{
  "version": 3,
  "cmakeMinimumRequired": 
  { 
    "major": 3, 
    "minor": 25, 
    "patch": 0 
  },
  "configurePresets": 
  [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": 
      {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "llvm-base",
      "hidden": true,
      "inherits": "base",
      "environment": 
      { 
        "CC": "clang-17", 
        "CXX": "clang++-17" 
      },
      "cacheVariables": { 
        "CMAKE_CUDA_HOST_COMPILER": "clang++-17" 
      }
    },
    {
      "name": "gnc-base",
      "hidden": true,
      "inherits": "base",
      "environment": { 
        "CC": "gcc", 
        "CXX": "g++", 
        "FC": "gfortran" 
      }
    },
    {
      "name": "llvm-release",
      "displayName": "LLVM Release (Native tuned)",
      "inherits": "llvm-base",
      "cacheVariables": 
      {
        "CMAKE_BUILD_TYPE": "Release",
        "PHYSI_SIM_MARCH": "native"
      }
    },
    {
      "name": "llvm-debug",
      "displayName": "LLVM Debug",
      "inherits": "llvm-base",
      "cacheVariables": { 
        "CMAKE_BUILD_TYPE": "Debug" 
      }
    },{
      "name": "gnc-release",
      "displayName": "GNC Release (x86-64-v3 + Hardened)",
      "inherits": "gnc-base",
      "cacheVariables": 
      {
        "CMAKE_BUILD_TYPE": "Release",
        "PHYSI_SIM_MARCH": "x86-64-v3",
        "PHYSI_SIM_ENABLE_HARDENING": "ON"
      }
    },{
      "name": "gnc-debug",
      "displayName": "GNC Debug (Bounds checked)",
      "inherits": "gnc-base",
      "cacheVariables": 
      {
        "CMAKE_BUILD_TYPE": "Debug",
        "PHYSI_SIM_ENABLE_ASSERTIONS": "ON"
      }
    }
  ],
  "buildPresets": 
  [
    { 
      "name": "llvm-release", 
      "configurePreset": "llvm-release" 
    },{ 
      "name": "llvm-debug",   
      "configurePreset": "llvm-debug" 
    },{ 
      "name": "gnc-release",  
      "configurePreset": "gnc-release" 
    },{ 
      "name": "gnc-debug",    
      "configurePreset": "gnc-debug" 
    }
  ],
  "testPresets": 
  [
    {
      "name": "llvm-release",
      "displayName": "Run Tests (LLVM Release)",
      "configurePreset": "llvm-release",
      "execution": { "stopOnFailure": false, "outputOnFailure": true }
    },
    {
      "name": "llvm-debug",
      "displayName": "Run Tests (LLVM Debug)",
      "configurePreset": "llvm-debug",
      "execution": { "stopOnFailure": false, "outputOnFailure": true }
    },
    {
      "name": "gnc-release",
      "displayName": "Run Tests (GNC Release)",
      "configurePreset": "gnc-release",
      "execution": { "stopOnFailure": false, "outputOnFailure": true }
    },
    {
      "name": "gnc-debug",
      "displayName": "Run Tests (GNC Debug)",
      "configurePreset": "gnc-debug",
      "execution": { "stopOnFailure": false, "outputOnFailure": true }
    }
  ]
}
