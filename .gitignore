# ---- build directories (all variants) ----
build*/
.deps/

# ---- compiled / build artifacts ----
*.o
*.a
*.mod
a.out

# ---- logs ----
*.log

# ---- LaTeX intermediates (docs/) — .tex and .pdf stay tracked ----
*.aux
*.toc
*.fls
*.fdb_latexmk
*.out
*.synctex.gz

# ---- Python ----
__pycache__/
*.pyc

# ---- simulation data outputs (regenerated; never tracked) ----
*.vtk
*.csv
output/
Testing/

# ---- exceptions: config that must stay tracked ----
!benchmark_config.json
# add  !tests/regression/data/*.csv  here if you commit baseline data

# ---- local-only ----
directory_structure.txt
.gitignore.bak

# editor swap / backup files
*.sw[a-p]
*~
python/legacy/
clean_repo.sh
